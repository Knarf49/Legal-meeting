datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  credentials   Credential?
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  records   Record[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Credential {
  id           String @id @default(cuid())
  userId       String @unique
  passwordHash String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecordChat {
  recordId String
  chatId   String

  record Record @relation(fields: [recordId], references: [id], onDelete: Cascade)
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@id([recordId, chatId])
  @@index([chatId])
}

model Chat {
  id       String    @id @default(cuid())
  title    String?
  messages Message[]

  records RecordChat[] // 👈 many-to-many

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MessageRole {
  tool
  user
  assistant
}

model Message {
  id          String      @id @default(cuid())
  chatId      String
  role        MessageRole
  content     String
  metadata    Json?
  isStreaming Boolean     @default(false)
  createdAt   DateTime    @default(now())
  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Record {
  id         String @id @default(cuid())
  title      String
  recordPath String
  duration   Float
  userId     String

  chats RecordChat[] // 👈 many-to-many

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model checkpoints {
  thread_id            String
  checkpoint_ns        String   @default("")
  checkpoint_id        String
  parent_checkpoint_id String?
  type                 String
  checkpoint           Json
  metadata             Json
  created_at           DateTime @default(now())

  @@id([thread_id, checkpoint_ns, checkpoint_id])
  @@index([thread_id])
}

model checkpoints_writes {
  thread_id     String
  checkpoint_ns String   @default("")
  checkpoint_id String
  task_id       String
  idx           String
  channel       String
  type          String
  value         Json
  created_at    DateTime @default(now())

  @@id([thread_id, checkpoint_ns, checkpoint_id, task_id, idx])
  @@index([thread_id])
}

model checkpoint_blobs {
  thread_id     String
  checkpoint_ns String   @default("")
  blob_id       String
  channel       String
  type          String
  data          Bytes
  version       Int      @default(0)
  created_at    DateTime @default(now())

  @@id([thread_id, checkpoint_ns, blob_id])
  @@index([thread_id])
}
